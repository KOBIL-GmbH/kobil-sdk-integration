        "ENFORCE_STRONG_HARDWARE",
        "ALLOW_VIRTUAL_SMART_CARD",
        "securityLevel 0",
        "NOT_SUPPORTED",
        "bcpkix",
        "sdk_deployment_preflight",
        "require_signed_jwt",
        "sdk_tms_explicit_preflight",
        "azp",
        "GetIamAccessTokenUsingJwtBearer",
        "JWT_BEARER_GRANT_TYPE",
        "802000007",
        "No identities are enrolled"
      ],
      "must_not_contain": []
    },
    "tms": {
      "must_contain": [
        "requireExplicitAuthentication",
        "OPTIONAL",
        "holder of the SDK's current token",
        "cold start with OfflineLogin",
        "KOBIL Mobile Login",
        "516004034",
        "516004035",
        "CANNOT_ACQUIRE_TOKEN_DATA",
        "FAILED/0",
        "never change a customer realm",
        "product decision",
        "escalate",
        "not_found",
        "directly after the SDK terminal event"
      ],
      "must_not_contain": []
    }
  },
  "references": {
