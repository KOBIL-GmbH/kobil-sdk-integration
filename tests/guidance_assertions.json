        "securityLevel 0",
        "NOT_SUPPORTED",
        "bcpkix",
        "sdk_deployment_preflight",
        "require_signed_jwt",
        "sdk_tms_explicit_preflight",
        "azp",
        "GetIamAccessTokenUsingJwtBearer",
        "JWT_BEARER_GRANT_TYPE"
      ],
      "must_not_contain": []
    },
    "tms": {
