        "requireExplicitAuthentication",
        "OPTIONAL",
        "holder of the SDK's current token",
        "cold start with OfflineLogin",
        "KOBIL Mobile Login",
        "516004034",
        "516004035",
        "CANNOT_ACQUIRE_TOKEN_DATA",
        "FAILED/0",
        "never change a customer realm",
        "product decision",
        "escalate"
      ],
      "must_not_contain": []
